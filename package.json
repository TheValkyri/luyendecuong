{
  "name": "fragrent-edtech-assessment-suite",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "High-Trust EdTech Assessment, Live Monitoring & Question Authoring Platform with Python DOC/DOCX/MTEF ETL Pipeline",
  "scripts": {
    "dev:server": "tsx server/index.ts",
    "dev:client": "vite --port 5173",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "test:etl": "python -m unittest discover -s etl -t . -p \"test_*.py\" -v",
    "test:e2e": "tsx scripts/run-browser-audit.ts",
    "test:all": "vitest run"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "katex": "^0.16.21",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "playwright": "^1.50.1",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
